# Environment Configuration Template
# Copy this file to .env and fill in your values:  cp .env.example .env

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Tourism HQ API ───────────────────────────────────────────────────────────
TOURISM_HQ_API_URL=https://booking.tourismhq.com/api/scoreboard

# API key for Tourism HQ authentication (Bearer token)
# Leave empty if the endpoint is public — the service will warn if unset and a 403 occurs
TOURISM_HQ_API_KEY=

# ─── HubSpot API ──────────────────────────────────────────────────────────────
# Regional base URL — use the URL that matches your HubSpot account region
# AP1 (Asia-Pacific): https://api-ap1.hubapi.com
# Default (US/EU):    https://api.hubapi.com
HUBSPOT_API_URL=https://api.hubapi.com

# Custom object ID (format: 2-XXXXXXXXX)
HUBSPOT_OBJECT_ID=2-XXXXXXXXX

# Private App access token — generate under Settings → Integrations → Private Apps
# Required scopes: crm.objects.custom.read, crm.objects.custom.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ─── Pagination & Batching ────────────────────────────────────────────────────
# Records fetched per page from HubSpot list endpoint (max: 100)
HUBSPOT_RECORDS_LIMIT=100

# Records per batch/update call (HubSpot hard limit: 100)
HUBSPOT_BATCH_SIZE=100

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Standard 5-field cron expression
# Examples:
#   0 * * * *    — every hour at :00
#   */15 * * * * — every 15 minutes
#   0 9-17 * * * — every hour, 9 AM–5 PM
CRON_SCHEDULE=0 * * * *

# ─── Request & Retry ──────────────────────────────────────────────────────────
# Per-request HTTP timeout (ms)
REQUEST_TIMEOUT_MS=10000

# Total attempts per operation, including the first (3 = one try + two retries)
MAX_RETRIES=3

# Initial retry backoff delay (ms); doubles on each subsequent attempt
RETRY_BACKOFF_MS=1000

# ─── Logging ──────────────────────────────────────────────────────────────────
# Levels: error | warn | info | debug
# Use 'debug' locally, 'info' or 'warn' in production
LOG_LEVEL=info
